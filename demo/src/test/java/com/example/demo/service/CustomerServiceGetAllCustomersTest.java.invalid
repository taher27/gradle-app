package com.example.demo.service;
import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerServiceGetAllCustomersTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    @BeforeEach
    void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    void getAllCustomersReturnsListWhenMultipleCustomersExist() {
        // Arrange
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        Customer customer3 = new Customer();
        List<Customer> expectedCustomers = Arrays.asList(customer1, customer2, customer3);
        
        when(customerRepository.findAll()).thenReturn(expectedCustomers);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers);
        assertEquals(3, actualCustomers.size());
        assertEquals(expectedCustomers, actualCustomers);
    }
    @Test
    @Tag("boundary")
    void getAllCustomersReturnsEmptyListWhenNoCustomersExist() {
        // Arrange
        List<Customer> emptyList = Collections.emptyList();
        when(customerRepository.findAll()).thenReturn(emptyList);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers);
        assertTrue(actualCustomers.isEmpty());
        assertEquals(0, actualCustomers.size());
    }
    @Test
    @Tag("boundary")
    void getAllCustomersReturnsListWithSingleCustomer() {
        // Arrange
        Customer singleCustomer = new Customer();
        List<Customer> singleCustomerList = Collections.singletonList(singleCustomer);
        
        when(customerRepository.findAll()).thenReturn(singleCustomerList);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers);
        assertEquals(1, actualCustomers.size());
        assertEquals(singleCustomer, actualCustomers.get(0));
    }
    @Test
    @Tag("integration")
    void getAllCustomersCallsRepositoryFindAllOnce() {
        // Arrange
        List<Customer> customerList = new ArrayList<>();
        when(customerRepository.findAll()).thenReturn(customerList);
        // Act
        customerService.getAllCustomers();
        // Assert
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    void getAllCustomersReturnsSameListReferenceFromRepository() {
        // Arrange
        List<Customer> specificList = new ArrayList<>();
        specificList.add(new Customer());
        
        when(customerRepository.findAll()).thenReturn(specificList);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertSame(specificList, actualCustomers);
    }
}